generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Package {
  id          String   @id @default(uuid())
  name        String
  description String
  price       Float
  category    String   // 'crece' or 'solutions'
  features    String   // Stored as JSON string
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Lead {
  id        String   @id @default(uuid())
  name      String
  email     String
  phone     String?
  message   String
  source    String   @default("contacto") // 'contacto' | 'cotizador'
  details   String?  // JSON con las respuestas del cotizador
  // De dónde vino la persona (misma atribución que las estadísticas)
  visitorId    String?
  attrSource   String?
  attrMedium   String?
  attrCampaign String?
  createdAt DateTime @default(now())
}

// Estadísticas propias: una fila por visita a una página o por acción (clic, chat, cotizador...).
// No guarda IP ni datos personales; visitorId es un identificador aleatorio del navegador.
model Event {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  day       String   // YYYY-MM-DD en hora de Lima
  type      String   // pageview, chat_open, whatsapp_click, quote_step, quote_submit...
  path      String
  visitorId String
  sessionId String
  source    String   // google, instagram, facebook, directo...
  medium    String?
  campaign  String?
  referrer  String?  // dominio de origen
  device    String   // mobile | tablet | desktop
  browser   String?
  os        String?
  props     String?  // JSON con datos extra del evento

  @@index([day])
  @@index([type, day])
  @@index([visitorId])
}

// Libro de Reclamaciones virtual (D.S. 011-2011-PCM y modificatorias).
// Conservar los registros al menos 2 años.
model Complaint {
  id            String    @id @default(uuid())
  number        Int       @unique // correlativo
  kind          String    // 'reclamo' | 'queja'
  name          String
  documentType  String    // 'DNI' | 'CE' | 'Pasaporte'
  documentNum   String
  address       String
  phone         String
  email         String
  guardian      String?   // padre, madre o apoderado si es menor de edad
  itemType      String    // 'producto' | 'servicio'
  amount        String?
  itemDetail    String
  detail        String
  request       String
  response      String?   // observaciones y acciones adoptadas por el proveedor
  respondedAt   DateTime?
  createdAt     DateTime  @default(now())
}
